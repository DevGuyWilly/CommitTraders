# PostgreSQL connection string
# Local development:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/commit_traders

# Supabase (Production / Remote PostgreSQL):
# Use the pooler URL, not the direct db.xxx URL (works over IPv4, more reliable)
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?sslmode=require
